{
  "name": "cricut",
  "version": "1.0.0",
  "private": true,
  "description": "Cricut Print Then Cut sheet maker: packs outlined stickers onto A4 sheets. Runs offline.",
  "scripts": {
    "dev": "next dev -p 3100",
